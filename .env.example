# Copy this file to .env for local development.
# Never commit service-role/secret keys to a Vite frontend.
VITE_SUPABASE_PROJECT_ID=your-project-ref
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Master kill switch only. Setting this true NEVER opens a product area by itself.
# Keep false in production until the exact-head release checklist is signed off.
VITE_COMMERCIAL_GA_ENABLED=false

# Independently qualified commercial browser surfaces (all fail closed by default).
# Flip ONLY the specific domain after server-side GA gating and end-to-end
# customer lifecycle evidence have passed at the exact deployed release SHA.
VITE_GA_INDIVIDUAL_SUBSCRIPTIONS_ENABLED=false
VITE_GA_USAGE_ADDONS_ENABLED=false
VITE_GA_TEAMS_SUBSCRIPTIONS_ENABLED=false
VITE_GA_PUBLISHING_SERVICES_ENABLED=false
VITE_GA_AI_COVERS_ENABLED=false
VITE_GA_CUSTOM_COVER_ENABLED=false
VITE_GA_ADVANCED_AUTHORING_ENABLED=false
VITE_GA_CHAPTER_REGENERATION_ENABLED=false
VITE_GA_EXPORTS_ENABLED=false
VITE_GA_EDITORIAL_PIPELINE_ENABLED=false
VITE_GA_RELEASE_SCHEDULING_ENABLED=false
VITE_GA_CANONICAL_PUBLICATION_ENABLED=false
VITE_GA_STRIPE_CONNECT_ENABLED=false

# Third-party creator marketplace sales have an additional payout-settlement gate.
# Keep false until Connect transfer/payout settlement is end-to-end verified.
VITE_MARKETPLACE_GA_ENABLED=false

# Specialized book generation is independent from the broader commercial surface.
# Keep false until at least one specialized mode has passed provider qualification.
VITE_SPECIALIZED_AUTHORING_ENABLED=false

# Public display allow-list only; the backend independently enforces GA_QUALIFIED_BOOK_TYPES.
# Leave empty until a specialized mode has passed provider qualification.
VITE_QUALIFIED_BOOK_TYPES=

# Optional browser error tracking. Leave blank to keep Sentry completely inert.
# A Sentry DSN is a client-side ingestion identifier, not an auth token.
VITE_SENTRY_DSN=

# Non-secret Supabase Edge/runtime origin configuration.
# Admin financial endpoints accept browser requests only from these exact origins.
# PUBLIC_SITE_URL defaults to https://scrolllibrary.org when unset.
PUBLIC_SITE_URL=https://scrolllibrary.org
APP_ORIGIN=
ADMIN_ALLOWED_ORIGINS=


# ── Server / Supabase Edge Function commercial GA switches ────────────────
# These are server-only runtime variables; never expose secret values to Vite.
GA_PAYMENTS_ENABLED=false
# Teams has an independent contract: pooled organization usage and included seats.
# Do not enable merely because Creator/Pro payment GA is open.
GA_TEAMS_SUBSCRIPTION_ENABLED=false
GA_MARKETPLACE_PAYMENTS_ENABLED=false
GA_MARKETPLACE_PAYOUTS_ENABLED=false
GA_PUBLISHING_SERVICES_BILLING_ENABLED=false
GA_PUBLICATION_MINT_ENABLED=false
GA_ADVANCED_AUTHORING_ENABLED=false
GA_SPECIALIZED_AUTHORING_ENABLED=false
GA_QUALIFIED_BOOK_TYPES=

# New sustainable public subscription catalogue.
STRIPE_PRODUCT_CREATOR=
STRIPE_PRODUCT_PRO=
STRIPE_PRODUCT_TEAMS=
STRIPE_PRICE_CREATOR_MONTHLY=
STRIPE_PRICE_CREATOR_ANNUAL=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_TEAMS_MONTHLY=
STRIPE_PRICE_TEAMS_ANNUAL=

# One-time usage packs.
STRIPE_PRICE_ADDON_AI_TEXT_250K=
STRIPE_PRICE_ADDON_VISUAL_50=
STRIPE_PRICE_ADDON_AUDIO_60=

# ScrollLibrary Press publishing services.
STRIPE_PRICE_PUBLISH_SINGLE_EDITION=
STRIPE_PRICE_PUBLISH_PRINT_DIGITAL=
STRIPE_PRICE_PUBLISH_COMPLETE_EDITION=
STRIPE_PRICE_PUBLISH_ASSISTED_LAUNCH=